SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
FRONTEND_URL=https://your-vercel-app.vercel.app

# Optional model routing: economy (default), balanced, quality
AI_ROUTING_MODE=economy
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_REASONING_MODEL=claude-sonnet-4-6
# Cache the stable notes/system prefix in Goblet of Fire (5-minute TTL).
AI_PROMPT_CACHING=true
